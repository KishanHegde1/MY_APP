API_BASE_URL=http://localhost:3000/api/v1
# Android Maps: android/local.properties -> MAPS_API_KEY
# Routes/Places server keys: backend/multi_service_backend/.env
FIREBASE_ENABLED=false
# Razorpay keys are backend-only. Add them in backend/multi_service_backend/.env
# and in the Render dashboard, not here.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=your_secret
# RAZORPAY_WEBHOOK_SECRET=
