NODE_ENV=production
PORT=3000
API_PREFIX=api
API_VERSION=1
# Neon pooled runtime connection copied from Connection Details.
DATABASE_URL=postgresql://NEON_USER:NEON_PASSWORD@ep-your-project-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Neon direct connection used only by TypeORM migration commands.
DATABASE_DIRECT_URL=postgresql://NEON_USER:NEON_PASSWORD@ep-your-project.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_SSL=true
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_POOL_MAX=20
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
CORS_ORIGIN=https://app.example.com
SWAGGER_ENABLED=false
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100
# Server-only key restricted to the Google Routes API and production backend egress IPs.
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_TIMEOUT_MS=8000
# Server-only key restricted to Places API (New) and production backend egress IPs.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT_MS=5000
GOOGLE_PLACES_LANGUAGE_CODE=en
GOOGLE_PLACES_REGION_CODE=IN
LOCAL_RIDE_MIN_DISTANCE_KM=1
LOCAL_RIDE_MAX_DISTANCE_KM=100
FIREBASE_PROJECT_ID=multi-service-1f99d
# Firebase Admin service-account credentials are required in production to
# verify Firebase ID tokens. Keep the private key out of source control.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CHECK_REVOKED_TOKENS=true
# Razorpay stays on the backend / Render dashboard. Do not put the secret in Flutter.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STORAGE_PROVIDER=local
