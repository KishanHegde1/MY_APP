NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
# Neon pooled connection for the running API. Copy it from Neon Connection Details.
DATABASE_URL=postgresql://NEON_USER:NEON_PASSWORD@ep-your-project-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Neon direct connection for TypeORM migration commands (host has no -pooler suffix).
DATABASE_DIRECT_URL=postgresql://NEON_USER:NEON_PASSWORD@ep-your-project.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_SSL=true
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_POOL_MAX=10
JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
SWAGGER_ENABLED=true
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100
# Server-only key restricted to the Google Routes API and this backend's egress IPs.
# Never copy this value into Flutter or commit a real key.
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_TIMEOUT_MS=8000
# Server-only key restricted to Places API (New) and this backend's egress IPs.
# It may use the same value as GOOGLE_ROUTES_API_KEY when that server key is
# restricted to both Routes API and Places API (New).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT_MS=5000
GOOGLE_PLACES_LANGUAGE_CODE=en
GOOGLE_PLACES_REGION_CODE=IN
LOCAL_RIDE_MIN_DISTANCE_KM=1
LOCAL_RIDE_MAX_DISTANCE_KM=100
FIREBASE_PROJECT_ID=multi-service-1f99d
# Leave these blank until you add Firebase Admin service-account credentials.
# With blank values the API starts, but it cannot verify Firebase ID tokens.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CHECK_REVOKED_TOKENS=false
# Razorpay payment gateway. Keep the secret only on the backend / Render;
# never add it to Flutter, AndroidManifest, or source control.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
# Add when Razorpay webhooks are enabled; it is not used by checkout yet.
RAZORPAY_WEBHOOK_SECRET=
STORAGE_PROVIDER=local
STORAGE_BUCKET=
